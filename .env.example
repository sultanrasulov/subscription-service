# Local development defaults (design §7). Not secrets for any real deployment.
#
# docker compose and `make run` read this file first, then an optional,
# uncommitted .env that overrides it. Put real values there.
#
# Keep values without quotes or spaces: compose and the shell must read
# this file the same way.

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=8s
HTTP_SHUTDOWN_TIMEOUT=10s

# Compose only, not read by the service: the host port that `docker compose up`
# publishes the app on. Compose reads it from the shell or .env, not from this
# file, so set it there, for example APP_PORT=18080 when 8080 is taken.
# APP_PORT=8080

# Logging. Level: debug, info, warn or error.
# Format: json (machines, containers) or text (reading locally; set it in .env).
LOG_LEVEL=info
LOG_FORMAT=json

# PostgreSQL. The service and the Postgres image read the same names.
# compose points POSTGRES_HOST and POSTGRES_PORT at the database service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=subscriptions
POSTGRES_PASSWORD=subscriptions
POSTGRES_DB=subscriptions
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_CONNECT_TIMEOUT=5s
